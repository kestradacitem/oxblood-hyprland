#!/bin/sh
# kb wrapper for HyprPanel: tray icons open their menu on LEFT click (right click = activate);
# the media menu shows one line "Artist - Song Title" that scrolls when it is too long (author/album rows hidden in config.json),
# and its time row reads "01:02:30 / 02:10:50 (-01:08:20)" (menus.media.displayTime on).
# Unpacks the packaged bundle, patches the systray click handler, and runs it exactly like
# /usr/share/hyprpanel/hyprpanel-app does. If the pattern isn't found, it runs unpatched.
[ "$#" -gt 0 ] && exec astal -i hyprpanel "$*"
f="${XDG_RUNTIME_DIR:-/tmp}/dmFyIF-ags.js"
sed -n '/^\/bin\/cat <<EOF/,/^EOF/p' /usr/share/hyprpanel/hyprpanel-app | sed '1d;$d' | base64 --decode > "$f"
python3 - "$f" <<'PY'
import sys
p = sys.argv[1]; s = open(p).read()
old = """        if (isPrimaryClick(event)) {
          item.activate(0, 0);
        }
        if (isSecondaryClick(event)) {
          menu?.popup_at_widget(self, Gdk.Gravity.NORTH, Gdk.Gravity.SOUTH, null);
        }"""
new = """        if (isPrimaryClick(event)) {
          if (menu) {
            // kb: open 6 px below the BAR (not the button) and keep 6 px from the screen edges,
            // like the kbshell popups and the other bar menus
            const top = self.get_toplevel(), a = self.get_allocation();
            const [, bx, by] = self.translate_coordinates(top, 0, 0);
            const sw = top.get_allocated_width(), mw = menu.get_preferred_width()[1];
            const left = bx + a.width / 2 - mw / 2;
            menu.rect_anchor_dy = top.get_allocated_height() - (by + a.height) + 6;
            menu.rect_anchor_dx = left + mw > sw - 6 ? Math.round(sw - 6 - mw - left) : left < 6 ? Math.round(6 - left) : 0;
            menu.popup_at_widget(self, Gdk.Gravity.SOUTH, Gdk.Gravity.NORTH, null);
          } else { item.activate(0, 0); }
        }
        if (isSecondaryClick(event)) {
          item.activate(0, 0);
        }"""
if old in s:
    s = s.replace(old, new, 1)
else:
    sys.stderr.write("kb hyprpanel wrapper: systray pattern not found, running unpatched\n")
# media menu: show the whole song title; if it doesn't fit, scroll it back and forth (marquee)
old = """      className: "media-indicator-current-song-name-label",
      label: bind(mediaTitle),
      maxWidthChars: 31,
      truncate: true,
      wrap: true
    }
  ) });"""
new = """      className: "media-indicator-current-song-name-label",
      label: bind(mediaTitle),
      maxWidthChars: 31,
      truncate: true,
      wrap: true
    }
  ), setup: (self) => {
    self.get_children().forEach((c) => { self.remove(c); c.destroy(); });
    self.set_halign(Gtk4.Align.FILL); self.set_hexpand(true);
    const text = () => { const a = (mediaArtist.get() ?? "").trim(), t = (mediaTitle.get() ?? "").trim(); return a && a !== "-----" ? `${a} - ${t}` : t; };
    const lbl = new Gtk4.Label({ label: text(), xalign: 0.5 });
    lbl.get_style_context().add_class("media-indicator-current-song-name-label");
    const sw = new Gtk4.ScrolledWindow({ hexpand: true, propagateNaturalWidth: true, maxContentWidth: 400, hscrollbarPolicy: Gtk4.PolicyType.EXTERNAL, vscrollbarPolicy: Gtk4.PolicyType.NEVER });
    sw.add(lbl); sw.get_child().set_shadow_type(Gtk4.ShadowType.NONE);
    self.add(sw); sw.show_all();
    let pos = 0, dir = 1, hold = 50;
    const reset = () => { pos = 0; dir = 1; hold = 50; sw.get_hadjustment().set_value(0); };
    const tick = GLib.timeout_add(GLib.PRIORITY_DEFAULT, 30, () => {
      if (!sw.get_mapped()) return true;
      const adj = sw.get_hadjustment(), max = adj.get_upper() - adj.get_page_size();
      if (max <= 1) { if (pos) reset(); return true; }
      if (hold > 0) { hold--; return true; }
      pos += dir;
      if (pos >= max) { pos = max; dir = -1; hold = 50; } else if (pos <= 0) { pos = 0; dir = 1; hold = 50; }
      adj.set_value(pos); return true;
    });
    const upd = () => { lbl.set_label(text()); reset(); };
    const unsubs = [mediaTitle.subscribe(upd), mediaArtist.subscribe(upd)];
    self.connect("destroy", () => { GLib.source_remove(tick); unsubs.forEach((u) => u()); });
  } });"""
if old in s:
    s = s.replace(old, new, 1)
else:
    sys.stderr.write("kb hyprpanel wrapper: media title pattern not found, title stays truncated\n")
# media menu: time row shows "current / total (-left)"
old = """    return `${getFormattedTime(position2)} / ${getFormattedTime(totalLength)}`;"""
new = """    return `${getFormattedTime(position2)} / ${getFormattedTime(totalLength)} (-${getFormattedTime(Math.max(0, totalLength - position2))})`;"""
if old in s:
    s = s.replace(old, new, 1)
else:
    sys.stderr.write("kb hyprpanel wrapper: timestamp pattern not found, no remaining time\n")
# media: follow the player that is actually playing (stock keeps the first-registered one,
# e.g. an idle Thorium tab, until the user clicks the next-player button)
old = """  _handlePlayerAdded(addedPlayer) {
    const { ignore: ignore6, preferredPlayer } = configuration_default.menus.media;
    if (isPlayerIgnored(addedPlayer, ignore6.get())) {
      return;
    }"""
new = """  _handlePlayerAdded(addedPlayer) {
    const { ignore: ignore6, preferredPlayer } = configuration_default.menus.media;
    if (isPlayerIgnored(addedPlayer, ignore6.get())) {
      return;
    }
    addedPlayer.connect("notify::playback-status", () => {
      if (addedPlayer.playbackStatus === AstalMpris.PlaybackStatus.PLAYING && addedPlayer.busName !== this.activePlayer.get()?.busName) {
        this.activePlayer.set(addedPlayer);
      }
    });
    if (addedPlayer.playbackStatus === AstalMpris.PlaybackStatus.PLAYING) {
      this.activePlayer.set(addedPlayer);
      return;
    }"""
n = 0
if old in s:
    s = s.replace(old, new, 1); n += 1
old = """    if (this.activePlayer.get() === void 0) {
      for (const player of filteredPlayers) {
        this._handlePlayerAdded(player);
      }
    }"""
new = """    for (const player of filteredPlayers) {
      const keep = this.activePlayer.get();
      this._handlePlayerAdded(player);
      if (keep !== void 0 && player.playbackStatus !== AstalMpris.PlaybackStatus.PLAYING) this.activePlayer.set(keep);
    }"""
if old in s:
    s = s.replace(old, new, 1); n += 1
old = """  activePlayer.set(filteredPlayers[0]);
  const songIcon = Variable("");"""
new = """  activePlayer.set(filteredPlayers.find((pl) => pl.playbackStatus === AstalMpris3.PlaybackStatus.PLAYING) ?? activePlayer.get() ?? filteredPlayers[0]);
  const songIcon = Variable("");"""
if old in s:
    s = s.replace(old, new, 1); n += 1
if n != 3:
    sys.stderr.write(f"kb hyprpanel wrapper: follow-playing patch applied {n}/3\n")
# tray: build the menu fresh from the app's dbusmenu on every click. libastal-tray rebuilds
# items on ItemsPropertiesUpdated with an unprefixed action ("id-3" instead of "dbusmenu.id-3"),
# so e.g. Spotify's "Show Spotify" stays greyed out after its window was shown/hidden once.
old = """var createMenu = (menuModel, actionGroup) => {"""
new = """var kbDbusMenu = (item) => {
  try {
    const bus = (item.item_id ?? "").split("/")[0], path = item.menu_path;
    if (!bus || !path) return null;
    const call = (m, args, type) => Gio.DBus.session.call_sync(bus, path, "com.canonical.dbusmenu", m, args, type ? new GLib.VariantType(type) : null, Gio.DBusCallFlags.NONE, 1000, null);
    try { call("AboutToShow", new GLib.Variant("(i)", [0]), null); } catch (e) {}
    const [, root] = call("GetLayout", new GLib.Variant("(iias)", [0, -1, []]), "(u(ia{sv}av))").recursiveUnpack();
    const build = (children) => {
      const m = new Gtk4.Menu();
      for (const [id, pr, sub] of children) {
        if (pr.visible === false) continue;
        let mi;
        if (pr.type === "separator") mi = new Gtk4.SeparatorMenuItem();
        else {
          const label = pr.label ?? "";
          if (pr["toggle-type"] === "checkmark" || pr["toggle-type"] === "radio") {
            mi = Gtk4.CheckMenuItem.new_with_mnemonic(label); mi.set_draw_as_radio(pr["toggle-type"] === "radio"); mi.set_active(pr["toggle-state"] === 1);
          } else mi = Gtk4.MenuItem.new_with_mnemonic(label);
          if (pr.enabled === false) mi.set_sensitive(false);
          if (sub.length) mi.set_submenu(build(sub));
          else mi.connect("activate", () => Gio.DBus.session.call(bus, path, "com.canonical.dbusmenu", "Event", new GLib.Variant("(isvu)", [id, "clicked", new GLib.Variant("s", ""), 0]), null, Gio.DBusCallFlags.NONE, 1000, null, null));
        }
        m.append(mi);
      }
      m.show_all();
      return m;
    };
    return build(root[2]);
  } catch (e) { console.error(`kb tray menu for ${item.id}: ${e}`); return null; }
};
var createMenu = (menuModel, actionGroup) => {"""
n = 0
if old in s:
    s = s.replace(old, new, 1); n += 1
old = """        if (isPrimaryClick(event)) {
          if (menu) {
            // kb: open 6 px"""
new = """        if (isPrimaryClick(event)) {
          const fresh = kbDbusMenu(item);
          if (fresh) { menu?.destroy(); menu = fresh; }
          if (menu) {
            // kb: open 6 px"""
if old in s:
    s = s.replace(old, new, 1); n += 1
if n != 2:
    sys.stderr.write(f"kb hyprpanel wrapper: fresh tray menu patch applied {n}/2\\n")
open(p, "w").write(s)
PY
LD_PRELOAD="" exec /usr/bin/gjs -m "$f"
