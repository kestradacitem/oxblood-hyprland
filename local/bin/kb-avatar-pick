#!/usr/bin/env python3
"""Pick a new profile picture (sets the system avatar, used by GNOME and the kb dashboard/bar)."""
import os, subprocess, gi
gi.require_version("Gtk", "4.0")
from gi.repository import Gtk, Gio
app = Gtk.Application(application_id="ph.kb.AvatarPick", flags=Gio.ApplicationFlags.NON_UNIQUE)
def act(a):
    a.hold()
    d = Gtk.FileDialog(title="Choose a profile picture")
    f = Gtk.FileFilter(); f.set_name("Images"); f.add_mime_type("image/*")
    fl = Gio.ListStore.new(Gtk.FileFilter); fl.append(f); d.set_filters(fl)
    d.set_initial_folder(Gio.File.new_for_path(os.path.expanduser("~/Pictures")))
    def done(dlg, res):
        try:
            g = dlg.open_finish(res)
            if g: subprocess.run(["@HOME@/.local/bin/kb-avatar-set", g.get_path()])
            subprocess.run(["notify-send", "Profile picture updated", "Used in GNOME and Hyprland"])
            # restart the bar so its small avatar refreshes
            subprocess.Popen(["sh", "-c", "P=$(hyprctl layers -j | jq -r '.[].levels[][] | select(.namespace==\"bar-0\") | .pid'); kill -9 $P; pgrep -f '^python3 /usr/share/hyprpanel/scripts/bluetooth.py$' | xargs -r kill -9; sleep 1; setsid -f @HOME@/.local/bin/hyprpanel >/dev/null 2>&1"])
        except Exception:
            pass
        a.release()
    d.open(None, None, done)
app.connect("activate", act); app.run([])
