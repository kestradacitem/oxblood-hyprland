#!/usr/bin/env python3
"""Log desktop notifications (D-Bus Notify calls) to ~/.cache/kb-qs/notifs.json for the kb dashboard."""
import json, os, subprocess, time, re
F = os.path.expanduser("~/.cache/kb-qs/notifs.json"); os.makedirs(os.path.dirname(F), exist_ok=True)
MAX = 50
def save(item):
    try: data = json.load(open(F))
    except Exception: data = []
    data.insert(0, item); data = data[:MAX]
    tmp = F + ".tmp"; json.dump(data, open(tmp, "w"), ensure_ascii=False); os.replace(tmp, F)
STR = re.compile(r'^\s*string "(.*)"\s*$')
while True:
    p = subprocess.Popen(["dbus-monitor", "--session",
                          "type='method_call',interface='org.freedesktop.Notifications',member='Notify'"],
                         stdout=subprocess.PIPE, text=True, bufsize=1)
    want, vals = False, []
    for line in p.stdout:
        if "member=Notify" in line and "method call" in line:
            want, vals = True, []; continue
        if want:
            m = STR.match(line)
            if m: vals.append(m.group(1).replace('\\"', '"'))
            if len(vals) == 4:      # app, icon, summary, body (uint32 replaces_id is skipped)
                app, icon, summ, body = vals
                if summ or body:
                    save({"id": f"{time.time():.3f}", "t": time.time(), "app": app or "Notification", "icon": icon, "summary": summ, "body": body})
                want = False
    time.sleep(2)
